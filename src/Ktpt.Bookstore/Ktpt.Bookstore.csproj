<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Автоматическое подключение базовых библиотек C# -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Имя выходного .exe файла и корневое пространство имён -->
    <AssemblyName>Ktpt.Bookstore</AssemblyName>
    <RootNamespace>Ktpt.Bookstore</RootNamespace>
    <!-- Значок приложения -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Классический Binding вместо скомпилированных привязок -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- Работа с SQL Server через Entity Framework Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Обновление зависимости SqlClient, в версии 9.0.11 есть известная уязвимость -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Рисунки и иконки упаковываются внутрь приложения -->
    <AvaloniaResource Include="Assets\**" />
    <!-- Строка подключения копируется в папку с программой -->
    <None Update="connection.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
